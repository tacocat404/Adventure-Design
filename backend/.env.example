# 이 파일을 .env로 복사하고 키를 넣으세요. .env는 레포에 올리지 않아요.
# 키는 충남대 AI 포털(aiportal.cnu.ac.kr) → API 키 탭에서 만들어요. 키가 없으면 요약은 키워드 버전으로 돌아요.
CNU_API_KEY=
CNU_BASE_URL=https://factchat-cloud.mindlogic.ai/v1/gateway
CNU_MODEL=claude-haiku-5-5
# 소셜 로그인 (진짜 로그인): 각 개발자 콘솔에서 앱을 만들고 키를 넣어요. 비워 두면 데모 로그인으로 돌아요.
# 콘솔에 등록할 redirect URI는 OAUTH_BASE + /api/auth/제공자/callback (예: http://localhost:5173/api/auth/kakao/callback)
OAUTH_BASE=http://localhost:5173
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 로컬 판단 모델을 끄려면 off
CUSHION_LOCAL_MODEL=on
