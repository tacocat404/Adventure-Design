{
 "_note": "Claude Sonnet 서브 에이전트가 만들고, 라벨을 지운 문장에 다른 에이전트가 다시 라벨을 붙여 두 번 다 맞은 것만. 실제 학부모 메시지 아님. 사람 검수 전.",
 "items": [
  {
   "text": "씨발 숙제가 왜 이렇게 많아요",
   "rough": true,
   "category": "normal",
   "type": "욕설_위협아님"
  },
  {
   "text": "ㅅㅂ 알림장 또 안 보냈네",
   "rough": true,
   "category": "normal",
   "type": "욕설_위협아님"
  },
  {
   "text": "존나 어이없네 진짜",
   "rough": true,
   "category": "normal",
   "type": "욕설_위협아님"
  },
  {
   "text": "개같네 이딴 식으로 하시니까 애가 힘들죠",
   "rough": true,
   "category": "normal",
   "type": "욕설_위협아님"
  },
  {
   "text": "ㅈㄴ 짜증나네 답장도 없고",
   "rough": true,
   "category": "normal",
   "type": "욕설_위협아님"
  },
  {
   "text": "시발 급식 메뉴 공지를 왜 이제 올려요",
   "rough": true,
   "category": "normal",
   "type": "욕설_위협아님"
  },
  {
   "text": "병신같이 일처리하네",
   "rough": true,
   "category": "normal",
   "type": "욕설_위협아님"
  },
  {
   "text": "ㅂㅅ 아니에요? 준비물을 전날 밤에 알려주면 어떡해요",
   "rough": true,
   "category": "normal",
   "type": "욕설_위협아님"
  },
  {
   "text": "미친 거 아니에요 이게 무슨 성적이야",
   "rough": true,
   "category": "normal",
   "type": "욕설_위협아님"
  },
  {
   "text": "또라이 같은 담임 만나서 우리 애만 고생이네",
   "rough": true,
   "category": "normal",
   "type": "욕설_위협아님"
  },
  {
   "text": "꺼져 지금 기분 더러우니까",
   "rough": true,
   "category": "normal",
   "type": "욕설_위협아님"
  },
  {
   "text": "닥치고 공지나 제대로 올려요",
   "rough": true,
   "category": "normal",
   "type": "욕설_위협아님"
  },
  {
   "text": "멍청하게 날짜를 잘못 적어놨네요",
   "rough": true,
   "category": "normal",
   "type": "욕설_위협아님"
  },
  {
   "text": "무능하다 무능해",
   "rough": true,
   "category": "normal",
   "type": "욕설_위협아님"
  },
  {
   "text": "한심하네 진짜 ㅋㅋ",
   "rough": true,
   "category": "normal",
   "type": "욕설_위협아님"
  },
  {
   "text": "쓰레기 같은 수행평가 기준이네",
   "rough": true,
   "category": "normal",
   "type": "욕설_위협아님"
  },
  {
   "text": "짜증나 죽겠네 진짜 이번 주만 몇 번째야",
   "rough": true,
   "category": "normal",
   "type": "욕설_위협아님"
  },
  {
   "text": "어이없네 학부모 상담 시간을 이렇게 잡아요?",
   "rough": true,
   "category": "normal",
   "type": "욕설_위협아님"
  },
  {
   "text": "장난하냐 지금 우리 애 자리가 맨 뒤라고?",
   "rough": true,
   "category": "normal",
   "type": "욕설_위협아님"
  },
  {
   "text": "씨 발 자리 바꿔달라고 몇 번을 말해요",
   "rough": true,
   "category": "normal",
   "type": "욕설_위협아님"
  },
  {
   "text": "개.념.없.네 정말",
   "rough": true,
   "category": "normal",
   "type": "욕설_위협아님"
  },
  {
   "text": "시1발 체험학습 비용 또 올랐네요",
   "rough": true,
   "category": "normal",
   "type": "욕설_위협아님"
  },
  {
   "text": "ㅆㅂ 단톡방에 공지 하나 올리는 게 그렇게 어렵나",
   "rough": true,
   "category": "normal",
   "type": "욕설_위협아님"
  },
  {
   "text": "ㅅ ㅂ 진짜 짜증난다",
   "rough": true,
   "category": "normal",
   "type": "욕설_위협아님"
  },
  {
   "text": "존나 불친절하시네요 선생님",
   "rough": true,
   "category": "normal",
   "type": "욕설_위협아님"
  },
  {
   "text": "ㅈㄴ 늦게 알려주고 어쩌라는 거예요",
   "rough": true,
   "category": "normal",
   "type": "욕설_위협아님"
  },
  {
   "text": "개같은 숙제 양 좀 줄여주세요",
   "rough": true,
   "category": "normal",
   "type": "욕설_위협아님"
  },
  {
   "text": "병 신 같은 가정통신문이네",
   "rough": true,
   "category": "normal",
   "type": "욕설_위협아님"
  },
  {
   "text": "ㅂㅅ같이 애들 편애하냐",
   "rough": true,
   "category": "normal",
   "type": "욕설_위협아님"
  },
  {
   "text": "미친 우리 애 점수가 왜 이래요",
   "rough": true,
   "category": "normal",
   "type": "욕설_위협아님"
  },
  {
   "text": "꺼지세요 연락 좀 그만하시고",
   "rough": true,
   "category": "normal",
   "type": "욕설_위협아님"
  },
  {
   "text": "닥쳐요 변명 듣기 싫으니까",
   "rough": true,
   "category": "normal",
   "type": "욕설_위협아님"
  },
  {
   "text": "애들 가르치는 사람이 멍청해서 되겠어요",
   "rough": true,
   "category": "normal",
   "type": "욕설_위협아님"
  },
  {
   "text": "무능한 담임 때문에 애가 학교 가기 싫대요",
   "rough": true,
   "category": "normal",
   "type": "욕설_위협아님"
  },
  {
   "text": "한심해서 말이 안 나오네요",
   "rough": true,
   "category": "normal",
   "type": "욕설_위협아님"
  },
  {
   "text": "쓰레기 같은 급식이 나왔다던데 확인은 하셨어요?",
   "rough": true,
   "category": "normal",
   "type": "욕설_위협아님"
  },
  {
   "text": "아 짜증나 죽겠네 준비물 또 바뀌었어요?",
   "rough": true,
   "category": "normal",
   "type": "욕설_위협아님"
  },
  {
   "text": "어이가 없어서 웃음만 나오네요",
   "rough": true,
   "category": "normal",
   "type": "욕설_위협아님"
  },
  {
   "text": "장난하세요? 시험 범위를 하루 전에 바꿔요?",
   "rough": true,
   "category": "normal",
   "type": "욕설_위협아님"
  },
  {
   "text": "아 씨발 또 문자 안 읽었네",
   "rough": true,
   "category": "normal",
   "type": "욕설_위협아님"
  },
  {
   "text": "시발 진짜 말이 안 통하네",
   "rough": true,
   "category": "normal",
   "type": "욕설_위협아님"
  },
  {
   "text": "ㅅㅂ 이걸 이제 알려줘요?",
   "rough": true,
   "category": "normal",
   "type": "욕설_위협아님"
  },
  {
   "text": "존나 한심하다 선생이",
   "rough": true,
   "category": "normal",
   "type": "욕설_위협아님"
  },
  {
   "text": "ㅈㄴ 무능해 보여요",
   "rough": true,
   "category": "normal",
   "type": "욕설_위협아님"
  },
  {
   "text": "개판이네 반 운영이",
   "rough": true,
   "category": "normal",
   "type": "욕설_위협아님"
  },
  {
   "text": "병신 같은 소리 하지 마세요",
   "rough": true,
   "category": "normal",
   "type": "욕설_위협아님"
  },
  {
   "text": "미친놈처럼 숙제를 내주네",
   "rough": true,
   "category": "normal",
   "type": "욕설_위협아님"
  },
  {
   "text": "또라이세요? 방학 숙제가 왜 이렇게 많아요",
   "rough": true,
   "category": "normal",
   "type": "욕설_위협아님"
  },
  {
   "text": "꺼져요 상담 필요 없어요",
   "rough": true,
   "category": "normal",
   "type": "욕설_위협아님"
  },
  {
   "text": "시발 우리 애 성적표 왜 이래요 오타 아니에요?",
   "rough": true,
   "category": "normal",
   "type": "욕설_위협아님"
  },
  {
   "text": "씨발 현장학습 신청서 마감이 오늘이었다고요?",
   "rough": true,
   "category": "normal",
   "type": "욕설_위협아님"
  },
  {
   "text": "ㅅㅂ 어제 말했어야지 오늘 아침에 말하면 어쩌라고",
   "rough": true,
   "category": "normal",
   "type": "욕설_위협아님"
  },
  {
   "text": "존나 짜증나요 하루 종일 연락도 안 되고",
   "rough": true,
   "category": "normal",
   "type": "욕설_위협아님"
  },
  {
   "text": "ㅈㄴ 불성실하시네요",
   "rough": true,
   "category": "normal",
   "type": "욕설_위협아님"
  },
  {
   "text": "개같이 일하시네요 정말",
   "rough": true,
   "category": "normal",
   "type": "욕설_위협아님"
  },
  {
   "text": "병신 ㅋㅋ 가정통신문에 오타가 세 개나 있네",
   "rough": true,
   "category": "normal",
   "type": "욕설_위협아님"
  },
  {
   "text": "ㅂㅅ인가 모둠 편성을 이렇게 해놨네",
   "rough": true,
   "category": "normal",
   "type": "욕설_위협아님"
  },
  {
   "text": "이런 미친 급식 반찬이 이게 뭐예요",
   "rough": true,
   "category": "normal",
   "type": "욕설_위협아님"
  },
  {
   "text": "또라이 같은 규칙을 왜 만들어서 애들 괴롭혀요",
   "rough": true,
   "category": "normal",
   "type": "욕설_위협아님"
  },
  {
   "text": "꺼지라고 하고 싶네요 진짜",
   "rough": true,
   "category": "normal",
   "type": "욕설_위협아님"
  },
  {
   "text": "닥치세요 더 듣기 싫습니다",
   "rough": true,
   "category": "normal",
   "type": "욕설_위협아님"
  },
  {
   "text": "멍청한 건지 일부러 그러는 건지 모르겠네",
   "rough": true,
   "category": "normal",
   "type": "욕설_위협아님"
  },
  {
   "text": "무능력의 극치네요",
   "rough": true,
   "category": "normal",
   "type": "욕설_위협아님"
  },
  {
   "text": "한심한 선생이 한둘이 아니지만 그중에서도 최악이에요",
   "rough": true,
   "category": "normal",
   "type": "욕설_위협아님"
  },
  {
   "text": "쓰레기 같은 반 분위기 만들어놓고 책임은 없대요",
   "rough": true,
   "category": "normal",
   "type": "욕설_위협아님"
  },
  {
   "text": "짜증나 죽겠어요 수업 시간표 또 바뀌었네",
   "rough": true,
   "category": "normal",
   "type": "욕설_위협아님"
  },
  {
   "text": "어이없다 정말 ㅡㅡ",
   "rough": true,
   "category": "normal",
   "type": "욕설_위협아님"
  },
  {
   "text": "장난하냐고요 숙제 검사도 안 하면서 왜 내요",
   "rough": true,
   "category": "normal",
   "type": "욕설_위협아님"
  },
  {
   "text": "ㅅㅂ 방과후 신청이 왜 이렇게 어려워요",
   "rough": true,
   "category": "normal",
   "type": "욕설_위협아님"
  },
  {
   "text": "씨빨 이게 뭐라고 이렇게 오래 걸려요",
   "rough": true,
   "category": "normal",
   "type": "욕설_위협아님"
  },
  {
   "text": "존.나 어이없네 ㅋ",
   "rough": true,
   "category": "normal",
   "type": "욕설_위협아님"
  },
  {
   "text": "ㅈ같네 진짜 이 반",
   "rough": true,
   "category": "normal",
   "type": "욕설_위협아님"
  },
  {
   "text": "조까 그게 말이 돼요?",
   "rough": true,
   "category": "normal",
   "type": "욕설_위협아님"
  },
  {
   "text": "시@발 단체복 사이즈 안 맞잖아요",
   "rough": true,
   "category": "normal",
   "type": "욕설_위협아님"
  },
  {
   "text": "쓰레기네 쓰레기 ㅋㅋ",
   "rough": true,
   "category": "normal",
   "type": "욕설_위협아님"
  },
  {
   "text": "애새끼들 관리도 못 하면서 무슨 담임이에요",
   "rough": true,
   "category": "normal",
   "type": "욕설_위협아님"
  },
  {
   "text": "니가 선생이냐",
   "rough": true,
   "category": "normal",
   "type": "욕설_위협아님"
  },
  {
   "text": "선생 자격 없네 자격이",
   "rough": true,
   "category": "normal",
   "type": "욕설_위협아님"
  },
  {
   "text": "수준 낮다 진짜",
   "rough": true,
   "category": "normal",
   "type": "욕설_위협아님"
  },
  {
   "text": "답답해 죽겠다 말귀를 못 알아듣네",
   "rough": true,
   "category": "normal",
   "type": "욕설_위협아님"
  },
  {
   "text": "머리가 있으면 생각을 좀 하세요 멍청하게",
   "rough": true,
   "category": "normal",
   "type": "욕설_위협아님"
  },
  {
   "text": "개짜증나요 오늘 알림장",
   "rough": true,
   "category": "normal",
   "type": "욕설_위협아님"
  },
  {
   "text": "개빡치네 진짜 ㅡㅡ",
   "rough": true,
   "category": "normal",
   "type": "욕설_위협아님"
  },
  {
   "text": "빡치게 하네 정말",
   "rough": true,
   "category": "normal",
   "type": "욕설_위협아님"
  },
  {
   "text": "아 진짜 존나 싫다 이 담임",
   "rough": true,
   "category": "normal",
   "type": "욕설_위협아님"
  },
  {
   "text": "ㅈㄴ 별로예요 이번 담임",
   "rough": true,
   "category": "normal",
   "type": "욕설_위협아님"
  },
  {
   "text": "이딴 식으로 일할 거면 그만두시지 그래요",
   "rough": true,
   "category": "normal",
   "type": "욕설_위협아님"
  },
  {
   "text": "무슨 선생이 이래 한심하게",
   "rough": true,
   "category": "normal",
   "type": "욕설_위협아님"
  },
  {
   "text": "참 어이없고 한심하네요 선생님",
   "rough": true,
   "category": "normal",
   "type": "욕설_위협아님"
  },
  {
   "text": "썩었네 썩었어 학교 꼴이",
   "rough": true,
   "category": "normal",
   "type": "욕설_위협아님"
  },
  {
   "text": "눈치가 없냐 센스가 없냐 ㅉㅉ",
   "rough": true,
   "category": "normal",
   "type": "욕설_위협아님"
  },
  {
   "text": "ㅉㅉ 한심하다 한심해",
   "rough": true,
   "category": "normal",
   "type": "욕설_위협아님"
  },
  {
   "text": "아 ㅅㅂ 우리 애 급식 알레르기 또 확인 안 했어요?",
   "rough": true,
   "category": "normal",
   "type": "욕설_위협아님"
  },
  {
   "text": "시발 우리 아들만 청소 당번이 왜 이렇게 많아",
   "rough": true,
   "category": "normal",
   "type": "욕설_위협아님"
  },
  {
   "text": "씨발 준비물 문자를 새벽에 보내면 어떡합니까",
   "rough": true,
   "category": "normal",
   "type": "욕설_위협아님"
  },
  {
   "text": "시발 아침부터 기분 잡치게 하네",
   "rough": true,
   "category": "normal",
   "type": "욕설_위협아님"
  },
  {
   "text": "개같은 하루네 선생님 때문에",
   "rough": true,
   "category": "normal",
   "type": "욕설_위협아님"
  },
  {
   "text": "존나 어이없는 게 우리 애 이름도 틀렸어요",
   "rough": true,
   "category": "normal",
   "type": "욕설_위협아님"
  },
  {
   "text": "상장 이름이 틀렸는데 사과도 없네 병신같이",
   "rough": true,
   "category": "normal",
   "type": "욕설_위협아님"
  },
  {
   "text": "이름 하나 못 맞추냐 멍청이야 뭐야",
   "rough": true,
   "category": "normal",
   "type": "욕설_위협아님"
  },
  {
   "text": "미친 듯이 짜증나네요 알림장 내용이 매번 달라서",
   "rough": true,
   "category": "normal",
   "type": "욕설_위협아님"
  },
  {
   "text": "ㅁㅊ 이거 실화냐 ㅋㅋ",
   "rough": true,
   "category": "normal",
   "type": "욕설_위협아님"
  },
  {
   "text": "ㅁㅊㄴ 같은 시간표네",
   "rough": true,
   "category": "normal",
   "type": "욕설_위협아님"
  },
  {
   "text": "ㅅㅂㄹㅁ 진짜 일을 왜 이렇게 해",
   "rough": true,
   "category": "normal",
   "type": "욕설_위협아님"
  },
  {
   "text": "ㅈㄹ하네 진짜 ㅋㅋ",
   "rough": true,
   "category": "normal",
   "type": "욕설_위협아님"
  },
  {
   "text": "지랄하지 말고 제대로 알려주세요",
   "rough": true,
   "category": "normal",
   "type": "욕설_위협아님"
  },
  {
   "text": "지랄이네 지랄 숙제 검사 좀 하고 내세요",
   "rough": true,
   "category": "normal",
   "type": "욕설_위협아님"
  },
  {
   "text": "염병 숙제가 너무 많네",
   "rough": true,
   "category": "normal",
   "type": "욕설_위협아님"
  },
  {
   "text": "썅 오늘도 연락 없네",
   "rough": true,
   "category": "normal",
   "type": "욕설_위협아님"
  },
  {
   "text": "개소리 좀 하지 마세요",
   "rough": true,
   "category": "normal",
   "type": "욕설_위협아님"
  },
  {
   "text": "헛소리 그만하고 성적이나 다시 확인해요",
   "rough": true,
   "category": "normal",
   "type": "욕설_위협아님"
  },
  {
   "text": "말 같지도 않은 소리를 하시네",
   "rough": true,
   "category": "normal",
   "type": "욕설_위협아님"
  },
  {
   "text": "뭔 개소리를 그렇게 길게 합니까",
   "rough": true,
   "category": "normal",
   "type": "욕설_위협아님"
  },
  {
   "text": "개판 오 분 전이네 이 반",
   "rough": true,
   "category": "normal",
   "type": "욕설_위협아님"
  },
  {
   "text": "엉망진창이네 진짜 어이없다",
   "rough": true,
   "category": "normal",
   "type": "욕설_위협아님"
  },
  {
   "text": "아 진짜 존나 못한다",
   "rough": true,
   "category": "normal",
   "type": "욕설_위협아님"
  },
  {
   "text": "존나 못하네 담임",
   "rough": true,
   "category": "normal",
   "type": "욕설_위협아님"
  },
  {
   "text": "ㅈㄴ못함 ㅋㅋ",
   "rough": true,
   "category": "normal",
   "type": "욕설_위협아님"
  },
  {
   "text": "ㅈㄴ느려 답장이",
   "rough": true,
   "category": "normal",
   "type": "욕설_위협아님"
  },
  {
   "text": "존나 늦게 답해주네 급한 일인데",
   "rough": true,
   "category": "normal",
   "type": "욕설_위협아님"
  },
  {
   "text": "ㅅㅂ 급한 건데 왜 읽씹이야",
   "rough": true,
   "category": "normal",
   "type": "욕설_위협아님"
  },
  {
   "text": "ㅆㅂ 읽씹하지 마세요",
   "rough": true,
   "category": "normal",
   "type": "욕설_위협아님"
  },
  {
   "text": "읽씹 ㅈㄴ 얄밉네",
   "rough": true,
   "category": "normal",
   "type": "욕설_위협아님"
  },
  {
   "text": "개얄밉네 진짜 ㅋㅋ",
   "rough": true,
   "category": "normal",
   "type": "욕설_위협아님"
  },
  {
   "text": "재수없네 말투가 왜 그래요",
   "rough": true,
   "category": "normal",
   "type": "욕설_위협아님"
  },
  {
   "text": "재수 없는 말투 좀 고치세요",
   "rough": true,
   "category": "normal",
   "type": "욕설_위협아님"
  },
  {
   "text": "말투가 ㅈㄴ 거슬려요",
   "rough": true,
   "category": "normal",
   "type": "욕설_위협아님"
  },
  {
   "text": "기분 더럽네 오늘 전화 받고",
   "rough": true,
   "category": "normal",
   "type": "욕설_위협아님"
  },
  {
   "text": "더러워서 진짜 말을 못 하겠네",
   "rough": true,
   "category": "normal",
   "type": "욕설_위협아님"
  },
  {
   "text": "아 더러워 이런 대접 받으려고 보낸 거 아닌데",
   "rough": true,
   "category": "normal",
   "type": "욕설_위협아님"
  },
  {
   "text": "꼴 보기 싫으니까 연락하지 마세요",
   "rough": true,
   "category": "normal",
   "type": "욕설_위협아님"
  },
  {
   "text": "꼴값 떨지 마세요",
   "rough": true,
   "category": "normal",
   "type": "욕설_위협아님"
  },
  {
   "text": "꼴사납네 정말 ㅋ",
   "rough": true,
   "category": "normal",
   "type": "욕설_위협아님"
  },
  {
   "text": "허접하네 수업이",
   "rough": true,
   "category": "normal",
   "type": "욕설_위협아님"
  },
  {
   "text": "허접한 수업 하면서 숙제만 많이 내네",
   "rough": true,
   "category": "normal",
   "type": "욕설_위협아님"
  },
  {
   "text": "수업을 병신처럼 하니까 성적이 이렇지",
   "rough": true,
   "category": "normal",
   "type": "욕설_위협아님"
  },
  {
   "text": "수업 ㅈㄴ 못한다고 애가 그러던데",
   "rough": true,
   "category": "normal",
   "type": "욕설_위협아님"
  },
  {
   "text": "애가 그러는데 선생님 수업 존나 지루하대요",
   "rough": true,
   "category": "normal",
   "type": "욕설_위협아님"
  },
  {
   "text": "노잼이라고 하던데요 선생님 수업",
   "rough": true,
   "category": "normal",
   "type": "욕설_위협아님"
  },
  {
   "text": "수업 ㅈ같다고 우리 애가 그래요",
   "rough": true,
   "category": "normal",
   "type": "욕설_위협아님"
  },
  {
   "text": "이 학교는 다 이런 병신들만 있나",
   "rough": true,
   "category": "normal",
   "type": "욕설_위협아님"
  },
  {
   "text": "교무실은 다 무능한 사람들뿐이네",
   "rough": true,
   "category": "normal",
   "type": "욕설_위협아님"
  },
  {
   "text": "교장이고 담임이고 다 무능해",
   "rough": true,
   "category": "normal",
   "type": "욕설_위협아님"
  },
  {
   "text": "학교 시스템이 개판이에요",
   "rough": true,
   "category": "normal",
   "type": "욕설_위협아님"
  },
  {
   "text": "이 학교 ㅈㄴ 별로네",
   "rough": true,
   "category": "normal",
   "type": "욕설_위협아님"
  },
  {
   "text": "시스템 개같네 진짜",
   "rough": true,
   "category": "normal",
   "type": "욕설_위협아님"
  },
  {
   "text": "ㅅㅂ 앱 알림 오류 왜 안 고쳐요",
   "rough": true,
   "category": "normal",
   "type": "욕설_위협아님"
  },
  {
   "text": "쿠션톡 알림도 안 오고 진짜 ㅈ같네",
   "rough": true,
   "category": "normal",
   "type": "욕설_위협아님"
  },
  {
   "text": "앱이 병신이네 알림이 안 와요",
   "rough": true,
   "category": "normal",
   "type": "욕설_위협아님"
  },
  {
   "text": "이 앱 쓰레기예요 공지가 안 뜸",
   "rough": true,
   "category": "normal",
   "type": "욕설_위협아님"
  },
  {
   "text": "메시지 읽었으면서 대답은 왜 안 하냐고",
   "rough": true,
   "category": "normal",
   "type": "욕설_위협아님"
  },
  {
   "text": "대답 좀 하라고 씨발",
   "rough": true,
   "category": "normal",
   "type": "욕설_위협아님"
  },
  {
   "text": "대답도 못하면서 선생 노릇은 하네",
   "rough": true,
   "category": "normal",
   "type": "욕설_위협아님"
  },
  {
   "text": "선생 노릇 제대로 해 멍청아",
   "rough": true,
   "category": "normal",
   "type": "욕설_위협아님"
  },
  {
   "text": "너 같은 선생 처음 본다",
   "rough": true,
   "category": "normal",
   "type": "욕설_위협아님"
  },
  {
   "text": "당신 진짜 한심하다",
   "rough": true,
   "category": "normal",
   "type": "욕설_위협아님"
  },
  {
   "text": "당신 같은 사람이 선생이라니 어이없네요",
   "rough": true,
   "category": "normal",
   "type": "욕설_위협아님"
  },
  {
   "text": "이게 선생이야 장난이야",
   "rough": true,
   "category": "normal",
   "type": "욕설_위협아님"
  },
  {
   "text": "이게 학교냐 시장판이냐",
   "rough": true,
   "category": "normal",
   "type": "욕설_위협아님"
  },
  {
   "text": "시장판이네 시장판 소란스럽기만 하고",
   "rough": true,
   "category": "normal",
   "type": "욕설_위협아님"
  },
  {
   "text": "이 반은 ㅈㄴ 시끄럽기만 하대요",
   "rough": true,
   "category": "normal",
   "type": "욕설_위협아님"
  },
  {
   "text": "ㅈㄴ 불공평하네 우리 애만 걸리고",
   "rough": true,
   "category": "normal",
   "type": "욕설_위협아님"
  },
  {
   "text": "공평하게 좀 하세요 씨발 진짜",
   "rough": true,
   "category": "normal",
   "type": "욕설_위협아님"
  },
  {
   "text": "편애 쩌네 진짜 ㅋㅋ",
   "rough": true,
   "category": "normal",
   "type": "욕설_위협아님"
  },
  {
   "text": "편애 개심하네",
   "rough": true,
   "category": "normal",
   "type": "욕설_위협아님"
  },
  {
   "text": "편애쟁이 같은 선생이네요",
   "rough": true,
   "category": "normal",
   "type": "욕설_위협아님"
  },
  {
   "text": "촌스럽게 왜 이래요 선생님",
   "rough": true,
   "category": "normal",
   "type": "욕설_위협아님"
  },
  {
   "text": "촌스러운 사고방식이네 아직도 이래요?",
   "rough": true,
   "category": "normal",
   "type": "욕설_위협아님"
  },
  {
   "text": "옛날 사람이네 진짜 답답",
   "rough": true,
   "category": "normal",
   "type": "욕설_위협아님"
  },
  {
   "text": "꼰대 같은 말씀 하지 마세요",
   "rough": true,
   "category": "normal",
   "type": "욕설_위협아님"
  },
  {
   "text": "꼰대 ㅈㄴ 심하네",
   "rough": true,
   "category": "normal",
   "type": "욕설_위협아님"
  },
  {
   "text": "아 진짜 개꼰대네 선생이",
   "rough": true,
   "category": "normal",
   "type": "욕설_위협아님"
  },
  {
   "text": "꼰대짓 좀 그만하세요",
   "rough": true,
   "category": "normal",
   "type": "욕설_위협아님"
  },
  {
   "text": "애 앞에서 망신 주냐 개념 없게",
   "rough": true,
   "category": "normal",
   "type": "욕설_위협아님"
  },
  {
   "text": "개념이 없어도 정도가 있지",
   "rough": true,
   "category": "normal",
   "type": "욕설_위협아님"
  },
  {
   "text": "개념 좀 챙기세요 개념",
   "rough": true,
   "category": "normal",
   "type": "욕설_위협아님"
  },
  {
   "text": "개 념 없 다 진짜",
   "rough": true,
   "category": "normal",
   "type": "욕설_위협아님"
  },
  {
   "text": "상식이 없네 상식이",
   "rough": true,
   "category": "normal",
   "type": "욕설_위협아님"
  },
  {
   "text": "상식 밖이에요 이건 진짜 미친 짓이에요",
   "rough": true,
   "category": "normal",
   "type": "욕설_위협아님"
  },
  {
   "text": "미친 짓이죠 이건 정말",
   "rough": true,
   "category": "normal",
   "type": "욕설_위협아님"
  },
  {
   "text": "미친 학교네 진짜",
   "rough": true,
   "category": "normal",
   "type": "욕설_위협아님"
  },
  {
   "text": "미친 반이에요 이 반은",
   "rough": true,
   "category": "normal",
   "type": "욕설_위협아님"
  },
  {
   "text": "정신 나갔어요? 시험지를 이렇게 내요?",
   "rough": true,
   "category": "normal",
   "type": "욕설_위협아님"
  },
  {
   "text": "정신 좀 차리세요 정신",
   "rough": true,
   "category": "normal",
   "type": "욕설_위협아님"
  },
  {
   "text": "제정신이에요? 이런 숙제를 내게",
   "rough": true,
   "category": "normal",
   "type": "욕설_위협아님"
  },
  {
   "text": "제정신 아니네 ㅋㅋ",
   "rough": true,
   "category": "normal",
   "type": "욕설_위협아님"
  },
  {
   "text": "ㅈㄴ 어이없다 ㅋㅋ 방금 문자 뭐예요",
   "rough": true,
   "category": "normal",
   "type": "욕설_위협아님"
  },
  {
   "text": "방금 뭐라고 했냐 ㅅㅂ",
   "rough": true,
   "category": "normal",
   "type": "욕설_위협아님"
  },
  {
   "text": "뭐라는 거야 씨발 말을 똑바로 해",
   "rough": true,
   "category": "normal",
   "type": "욕설_위협아님"
  },
  {
   "text": "뭔 소리야 병신아",
   "rough": true,
   "category": "normal",
   "type": "욕설_위협아님"
  },
  {
   "text": "뭔 소린지 하나도 모르겠네 ㅅㅂ",
   "rough": true,
   "category": "normal",
   "type": "욕설_위협아님"
  },
  {
   "text": "설명을 개같이 하네요 진짜",
   "rough": true,
   "category": "normal",
   "type": "욕설_위협아님"
  },
  {
   "text": "설명을 ㅈㄴ 못하세요",
   "rough": true,
   "category": "normal",
   "type": "욕설_위협아님"
  },
  {
   "text": "설명도 못 하면서 가르친다고요?",
   "rough": true,
   "category": "normal",
   "type": "욕설_위협아님"
  },
  {
   "text": "못 가르치면 그만두세요 무능한 선생님",
   "rough": true,
   "category": "normal",
   "type": "욕설_위협아님"
  },
  {
   "text": "무능한데 월급은 받네",
   "rough": true,
   "category": "normal",
   "type": "욕설_위협아님"
  },
  {
   "text": "월급 도둑이네 월급 도둑",
   "rough": true,
   "category": "normal",
   "type": "욕설_위협아님"
  },
  {
   "text": "월급 아깝다 진짜",
   "rough": true,
   "category": "normal",
   "type": "욕설_위협아님"
  },
  {
   "text": "세금 아깝다 ㅋㅋ",
   "rough": true,
   "category": "normal",
   "type": "욕설_위협아님"
  },
  {
   "text": "밥값도 못 하네",
