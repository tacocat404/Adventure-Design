   "category": "normal",
   "type": "반말무례"
  },
  {
   "text": "얘기가 안 통하네 선생이랑은",
   "rough": true,
   "category": "normal",
   "type": "반말무례"
  },
  {
   "text": "됐으니까 그냥 해줘",
   "rough": true,
   "category": "normal",
   "type": "반말무례"
  },
  {
   "text": "빨리 처리해 오늘 안에",
   "rough": true,
   "category": "normal",
   "type": "반말무례"
  },
  {
   "text": "시간 없으니까 지금 바로 연락 줘",
   "rough": true,
   "category": "normal",
   "type": "반말무례"
  },
  {
   "text": "이 공지 언제 보낼 거야 빨리 올려",
   "rough": true,
   "category": "normal",
   "type": "반말무례"
  },
  {
   "text": "답장 좀 빨리빨리 해라 선생",
   "rough": true,
   "category": "normal",
   "type": "반말무례"
  },
  {
   "text": "숙제 양 줄여 애 힘들어하잖아",
   "rough": true,
   "category": "normal",
   "type": "반말무례"
  }
 ]
